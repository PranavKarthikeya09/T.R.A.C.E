# T.R.A.C.E. Backend Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# Do not commit real secrets or production credentials to version control.

# Application Configuration
APP_NAME=T.R.A.C.E.
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Media and Upload Constraints (per TDD / API_SPEC)
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp
TEMP_UPLOAD_DIR=temp_uploads

# Azure AI Foundry Vision Model Configuration
# When configured, uploaded images are sent securely to this endpoint for remote visual analysis.
# Azure Endpoint: base URL or full completions endpoint
# e.g., https://<your-resource-name>.openai.azure.com/ or https://<your-resource-name>.services.ai.azure.com/openai/v1
AZURE_AI_ENDPOINT=https://your-resource-name.services.ai.azure.com/openai/v1

# Azure API Key (Do not commit real keys!)
AZURE_AI_API_KEY=your-azure-api-key-here

# Deployment name as configured in Azure AI Foundry (e.g., gpt-4.1-mini, gpt-4o, gpt-4o-mini)
AZURE_AI_DEPLOYMENT_NAME=gpt-4.1-mini

# API Version (typically 2024-08-01-preview or 2024-10-21)
AZURE_AI_API_VERSION=2024-08-01-preview

# Request timeout in seconds
AZURE_AI_REQUEST_TIMEOUT_SECONDS=30.0

# Provenance Configuration
ENABLE_PROVENANCE_CHECK=False

# Official Reporting Support
OFFICIAL_REPORTING_URL=https://cybercrime.gov.in/
