# T.R.A.C.E. Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# Do not commit real secrets or production credentials to version control.

# Application Configuration
APP_NAME=T.R.A.C.E.
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Media and Upload Constraints (per TDD / API_SPEC)
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp
TEMP_UPLOAD_DIR=temp_uploads

# AI Model Configuration
# Placeholder model identifier; will be finalized in Phase 2
MODEL_ID=candidate-detector-v1
MODEL_DEVICE=cpu

# Provenance Configuration
ENABLE_PROVENANCE_CHECK=False

# Official Reporting Support
OFFICIAL_REPORTING_URL=https://cybercrime.gov.in/
